# R8 rules for the release build. Everything here answers a reflective lookup that
# the shrinker cannot follow: kotlinx.serialization decodes the journal and the sync
# frames by generated serializer, BouncyCastle registers JCA providers by class name,
# and ktor plus jmdns resolve a few classes from strings.

-keepattributes *Annotation*, InnerClasses, Signature, EnclosingMethod, Exceptions

# --- kotlinx.serialization -------------------------------------------------
# Generated serializers live in synthetic classes; the runtime looks them up through
# the companion and the `serializer()` function, so both must survive renaming.
-keep,includedescriptorclasses class app.journal.**$$serializer { *; }
-keepclassmembers class app.journal.** {
    *** Companion;
    kotlinx.serialization.KSerializer serializer(...);
}
-keepclasseswithmembers class app.journal.** {
    kotlinx.serialization.KSerializer serializer(...);
}
-keep class app.journal.model.** { *; }
-keep class app.journal.serde.** { *; }

# Polymorphic and generic serializers build reflection-based descriptors.
-keep,includedescriptorclasses class kotlinx.serialization.** { *; }
-dontwarn kotlinx.serialization.**

# --- Phone/persistence surface --------------------------------------------
# The bundled catalog is opened through SQLDelight's Android driver, which resolves
# nothing by name, but the generated database classes are referenced from enums and
# callback lambdas that R8 can otherwise fold away.
-keep class app.journal.catalog.** { *; }
-keep class app.journal.sync.** { *; }

# zstd-jni loads its native library and checks a class named after the platform.
-keep class com.github.luben.zstd.** { *; }

# --- Ktor, websockets, jmdns ----------------------------------------------
# Ktor resolves client engines and content converters from strings and ServiceLoader.
-keep class io.ktor.** { *; }
-dontwarn io.ktor.**

# jmdns is the LAN discovery library; its listeners are registered reflectively.
-keep class javax.jmdns.** { *; }
-dontwarn javax.jmdns.**

# --- BouncyCastle ---------------------------------------------------------
# The provider is registered by fully qualified class name (bcprov/bcpkix).
-keep class org.bouncycastle.** { *; }
-dontwarn org.bouncycastle.**

# --- Noise ----------------------------------------------------------------
# Optional integrations that never load on Android.
-dontwarn org.slf4j.**
-dontwarn org.apache.**
-dontwarn org.openjsse.**
-dontwarn com.sun.jna.**
-dontwarn java.awt.**
-dontwarn javax.swing.**

# Optional native and JDK-only references reachable from the shared JVM sources.
# Generated by R8 (missing_rules.txt) and trimmed to the entries this app needs.
-dontwarn io.netty.internal.tcnative.AsyncSSLPrivateKeyMethod
-dontwarn io.netty.internal.tcnative.AsyncTask
-dontwarn io.netty.internal.tcnative.Buffer
-dontwarn io.netty.internal.tcnative.CertificateCallback
-dontwarn io.netty.internal.tcnative.CertificateCompressionAlgo
-dontwarn io.netty.internal.tcnative.CertificateVerifier
-dontwarn io.netty.internal.tcnative.Library
-dontwarn io.netty.internal.tcnative.SSL
-dontwarn io.netty.internal.tcnative.SSLContext
-dontwarn io.netty.internal.tcnative.SSLPrivateKeyMethod
-dontwarn io.netty.internal.tcnative.SSLSessionCache
-dontwarn io.netty.internal.tcnative.SessionTicketKey
-dontwarn io.netty.internal.tcnative.SniHostNameMatcher
-dontwarn java.lang.Module
-dontwarn java.lang.ProcessHandle
-dontwarn java.lang.management.ManagementFactory
-dontwarn java.lang.management.RuntimeMXBean
-dontwarn javax.naming.ldap.LdapName
-dontwarn javax.naming.ldap.Rdn
-dontwarn jdk.jfr.Category
-dontwarn jdk.jfr.DataAmount
-dontwarn jdk.jfr.Description
-dontwarn jdk.jfr.Enabled
-dontwarn jdk.jfr.Event
-dontwarn jdk.jfr.FlightRecorder
-dontwarn jdk.jfr.FlightRecorderListener
-dontwarn jdk.jfr.Label
-dontwarn jdk.jfr.MemoryAddress
-dontwarn jdk.jfr.Name
-dontwarn jdk.jfr.Registered
-dontwarn org.conscrypt.BufferAllocator
-dontwarn org.conscrypt.Conscrypt
-dontwarn org.conscrypt.HandshakeListener
-dontwarn reactor.blockhound.integration.BlockHoundIntegration

# Netty's JDK 22+ cleaner path; Android has no java.lang.foreign.
-dontwarn java.lang.foreign.**
