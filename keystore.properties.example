# Copy to keystore.properties and fill in. NEVER commit the real file.
# The release signingConfig is only active when this file exists, so
# F-Droid and plain builds stay secret-free and reproducible.
#
# Generate the keystore once (see docs/GOOGLE-PLAY.md):
#   keytool -genkeypair -v -keystore nepenthe-upload.keystore \
#     -alias nepenthe -keyalg RSA -keysize 4096 -validity 10000

storeFile=nepenthe-upload.keystore
storePassword=CHANGE_ME
keyAlias=nepenthe
keyPassword=CHANGE_ME
